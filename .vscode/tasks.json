{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: 配置",
            "type": "shell",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build"],
            "problemMatcher": []
        },
        {
            "label": "CMake: 编译全部练习",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build"],
            "dependsOn": ["CMake: 配置"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
